data class AtmosphericSceneConfig(
    val title: String,
    val moodKey: String,
    val videoSampleUrl: String,
    val gradientColors: List<Color>,
    val particleColor: Color
)

object VideoPresets {
    val candleScene = AtmosphericSceneConfig(
        title = "Мерцающая свеча",
        moodKey = "свеча",
        videoSampleUrl = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/WeAreGoingOnBullrun.mp4",
        gradientColors = listOf(Color(0xFF2B1B10), Color(0xFF19110B), Color(0xFF0F0A07)),
        particleColor = Color(0xFFFFC078)
    )

    val pagesScene = AtmosphericSceneConfig(
        title = "Шелест страниц",
        moodKey = "страницы",
        videoSampleUrl = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
        gradientColors = listOf(Color(0xFF261E17), Color(0xFF1C1611), Color(0xFF120E0A)),
        particleColor = Color(0xFFE8D5B5)
    )

    val teaScene = AtmosphericSceneConfig(
        title = "Чай у окна",
        moodKey = "чай",
        videoSampleUrl = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4",
        gradientColors = listOf(Color(0xFF281F1A), Color(0xFF1E1713), Color(0xFF140F0C)),
        particleColor = Color(0xFFFFD199)
    )

    val starsScene = AtmosphericSceneConfig(
        title = "Звездное небо",
        moodKey = "звезды",
        videoSampleUrl = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4",
        gradientColors = listOf(Color(0xFF121526), Color(0xFF0C0E1B), Color(0xFF080911)),
        particleColor = Color(0xFFE0E7FF)
    )

    fun getSceneByMood(mood: String): AtmosphericSceneConfig {
        return when (mood.lowercase()) {
            "страницы" -> pagesScene
            "чай" -> teaScene
            "звезды" -> starsScene
            else -> candleScene
        }
    }
}

@OptIn(UnstableApi::class)
@Composable
fun AtmosphericVideoPlayer(
    quoteText: String,
    author: String,
    bookTitle: String,
    visualMood: String,
    narrationText: String = "",
    onPlayNarration: (() -> Unit)? = null,
    modifier: Modifier = Modifier
) {
    val context = LocalContext.current
    val scene = remember(visualMood) { VideoPresets.getSceneByMood(visualMood) }

    var isPlaying by remember { mutableStateOf(true) }
    var hasVideoError by remember { mutableStateOf(false) }

    // Media3 ExoPlayer instance with looping
    val exoPlayer = remember(scene.moodKey) {
        ExoPlayer.Builder(context).build().apply {
            repeatMode = Player.REPEAT_MODE_ONE
            try {
                val mediaItem = MediaItem.fromUri(Uri.parse(scene.videoSampleUrl))
                setMediaItem(mediaItem)
                prepare()
                playWhenReady = true
                volume = 0.2f // Subtle background audio
            } catch (e: Exception) {
                hasVideoError = true
            }
            addListener(object : Player.Listener {
                override fun onPlayerError(error: androidx.media3.common.PlaybackException) {
                    hasVideoError = true
                }
            })
        }
    }

    DisposableEffect(exoPlayer) {
        onDispose {
            exoPlayer.release()
        }
    }

    // Infinite breathing animations for the living page effect
    val infiniteTransition = rememberInfiniteTransition(label = "living_page")
    val candleFlicker by infiniteTransition.animateFloat(
        initialValue = 0.85f,
        targetValue = 1.15f,
        animationSpec = infiniteRepeatable(
            animation = tween(1800, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "flicker"
    )

    val particleOffset by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 1000f,
        animationSpec = infiniteRepeatable(
            animation = tween(12000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "particles"
    )

    Box(
        modifier = modifier
            .fillMaxSize()
            .clip(RoundedCornerShape(20.dp))
            .background(Color.Black)
    ) {
        // Video Layer via Media3 ExoPlayer (or fallback to animated artistic canvas)
        if (!hasVideoError) {
            AndroidView(
                factory = { ctx ->
                    PlayerView(ctx).apply {
                        player = exoPlayer
                        useController = false
                        resizeMode = AspectRatioFrameLayout.RESIZE_MODE_ZOOM
                    }
                },
                modifier = Modifier.fillMaxSize()
            )
        }

        // Atmospheric living canvas overlay (soft embers, gentle book dusk, particles)
        Canvas(modifier = Modifier.fillMaxSize()) {
            drawAtmosphericOverlay(
                colors = scene.gradientColors,
                particleColor = scene.particleColor,
                particleOffset = particleOffset,
                glowMultiplier = candleFlicker,
                hasVideo = !hasVideoError
            )
        }

        // Vignette gradient for cinematic readability
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(
                    Brush.verticalGradient(
                        colors = listOf(
                            Color.Black.copy(alpha = 0.45f),
                            Color.Transparent,
                            Color.Black.copy(alpha = 0.82f)
                        )
                    )
                )
        )

        // Top Bar: Scene Indicator & Badge
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(20.dp)
                .align(Alignment.TopCenter),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Surface(
                color = Color.Black.copy(alpha = 0.45f),
                shape = RoundedCornerShape(12.dp)
            ) {
                Row(
                    modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(8.dp)
                            .clip(CircleShape)
                            .background(GoldenGlow)
                    )
                    Spacer(modifier = Modifier.width(8.dp))
                    Text(
                        text = "Живая Страница • ${scene.title}",
                        style = MaterialTheme.typography.labelMedium,
                        color = Color(0xFFF3ECE0)
                    )
                }
            }

            Spacer(modifier = Modifier.weight(1f))

            // Play/Pause button
            IconButton(
                onClick = {
                    if (isPlaying) {
                        exoPlayer.pause()
                        isPlaying = false
                    } else {
                        exoPlayer.play()
                        isPlaying = true
                    }
                },
                modifier = Modifier
                    .size(40.dp)
                    .background(Color.Black.copy(alpha = 0.45f), CircleShape)
            ) {
                Icon(
                    imageVector = if (isPlaying) Icons.Default.Pause else Icons.Default.PlayArrow,
                    contentDescription = if (isPlaying) "Пауза" else "Воспроизведение",
                    tint = Color.White
                )
            }
        }

        // Center / Bottom: The Cinematic Quote & Audio narration pill
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .align(Alignment.BottomCenter)
                .padding(horizontal = 24.dp, vertical = 32.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            // Elegant Quote Marker
            Text(
                text = "«",
                fontFamily = PlayfairFontFamily,
                fontSize = 44.sp,
                fontWeight = FontWeight.Bold,
                color = GoldenGlow.copy(alpha = 0.9f),
                lineHeight = 36.sp
            )

            // The Main Quote in Playfair Display
            Text(
                text = quoteText,
                fontFamily = PlayfairFontFamily,
                fontWeight = FontWeight.Bold,
                fontSize = 22.sp,
                lineHeight = 32.sp,
                textAlign = TextAlign.Center,
                color = Color(0xFFFFF8E7),
                modifier = Modifier.padding(bottom = 12.dp)
            )

            // Author and Book Title
            Text(
                text = "— $author" + if (bookTitle.isNotBlank()) ", «$bookTitle»" else "",
                style = MaterialTheme.typography.bodyMedium,
                fontWeight = FontWeight.Medium,
                color = Color(0xFFD8CEBF),
                textAlign = TextAlign.Center
            )

            Spacer(modifier = Modifier.height(16.dp))

            // Voiceover narration trigger button if available
            if (narrationText.isNotBlank() && onPlayNarration != null) {
                Surface(
                    onClick = onPlayNarration,
                    color = WarmAmberPrimary.copy(alpha = 0.85f),
                    shape = RoundedCornerShape(24.dp),
                    modifier = Modifier.padding(top = 8.dp)
                ) {
                    Row(
                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(
                            imageVector = Icons.Default.VolumeUp,
                            contentDescription = "Слушать голос",
                            tint = Color.White,
                            modifier = Modifier.size(18.dp)
                        )
                        Spacer(modifier = Modifier.width(8.dp))
                        Text(
                            text = "Озвучить мысль (TTS)",
                            style = MaterialTheme.typography.labelMedium,
                            color = Color.White
                        )
                    }
                }
            }
        }
    }
}

private fun DrawScope.drawAtmosphericOverlay(
    colors: List<Color>,
    particleColor: Color,
    particleOffset: Float,
    glowMultiplier: Float,
    hasVideo: Boolean
) {
    if (!hasVideo) {
        // Draw artistic background if video is not yet loaded
        drawRect(
            brush = Brush.radialGradient(
                colors = colors,
                center = Offset(size.width * 0.5f, size.height * 0.4f),
                radius = size.width * 0.9f * glowMultiplier
            )
        )
    }

    // Gentle floating dust particles / stars
    val particleCount = 28
    for (i in 0 until particleCount) {
        val seedX = ((i * 137.5f) % size.width)
        val seedY = ((i * 243.7f + particleOffset) % size.height)
        val radius = ((i % 4) + 1.5f) * (0.8f + 0.3f * glowMultiplier)
        val alpha = ((i % 5) + 3) / 10f * 0.55f

        drawCircle(
            color = particleColor.copy(alpha = alpha),
            radius = radius,
            center = Offset(seedX, seedY)
        )
    }
}
