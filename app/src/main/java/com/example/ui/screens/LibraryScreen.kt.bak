@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun LibraryScreen(
    viewModel: MainViewModel,
    onNavigateToReader: (Long) -> Unit,
    onNavigateToVideoStudio: (String, String, String) -> Unit,
    modifier: Modifier = Modifier
) {
    var selectedTab by remember { mutableIntStateOf(0) }
    val tabTitles = listOf("Книги", "Цитаты", "Живые Видео")

    val books by viewModel.books.collectAsState()
    val quotes by viewModel.quotes.collectAsState()
    val videoStories by viewModel.videoStories.collectAsState()

    var activePlayingStory by remember { mutableStateOf<VideoStoryEntity?>(null) }

    Scaffold(
        containerColor = MaterialTheme.colorScheme.background,
        modifier = modifier
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {
            // Header
            Column(
                modifier = Modifier.padding(horizontal = 20.dp, vertical = 14.dp)
            ) {
                Text(
                    text = "Моя Полка",
                    style = MaterialTheme.typography.titleLarge,
                    fontFamily = PlayfairFontFamily,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onBackground
                )
                Text(
                    text = "Ваша коллекция книг, мыслей и видео-открыток",
                    style = MaterialTheme.typography.bodySmall,
                    color = MutedInkText
                )
            }

            // Tab Row
            TabRow(
                selectedTabIndex = selectedTab,
                containerColor = MaterialTheme.colorScheme.background,
                contentColor = WarmAmberPrimary,
                indicator = { tabPositions ->
                    TabRowDefaults.SecondaryIndicator(
                        Modifier.tabIndicatorOffset(tabPositions[selectedTab]),
                        color = WarmAmberPrimary
                    )
                }
            ) {
                tabTitles.forEachIndexed { index, title ->
                    Tab(
                        selected = selectedTab == index,
                        onClick = { selectedTab = index },
                        text = {
                            val count = when (index) {
                                0 -> books.size
                                1 -> quotes.size
                                else -> videoStories.size
                            }
                            Text(
                                text = "$title ($count)",
                                style = MaterialTheme.typography.labelLarge,
                                fontWeight = if (selectedTab == index) FontWeight.Bold else FontWeight.Normal
                            )
                        }
                    )
                }
            }

            // Tab Content
            when (selectedTab) {
                0 -> {
                    // Books Tab
                    LazyColumn(
                        modifier = Modifier.fillMaxSize(),
                        contentPadding = PaddingValues(16.dp),
                        verticalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        items(books) { book ->
                            Card(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .clickable { onNavigateToReader(book.id) },
                                shape = RoundedCornerShape(16.dp),
                                colors = CardDefaults.cardColors(
                                    containerColor = MaterialTheme.colorScheme.surface
                                )
                            ) {
                                Row(
                                    modifier = Modifier.padding(16.dp),
                                    verticalAlignment = Alignment.CenterVertically
                                ) {
                                    Box(
                                        modifier = Modifier
                                            .size(54.dp)
                                            .clip(RoundedCornerShape(12.dp))
                                            .background(ParchmentSurface),
                                        contentAlignment = Alignment.Center
                                    ) {
                                        Icon(
                                            imageVector = Icons.Default.MenuBook,
                                            contentDescription = null,
                                            tint = WarmAmberPrimary,
                                            modifier = Modifier.size(28.dp)
                                        )
                                    }

                                    Spacer(modifier = Modifier.width(16.dp))

                                    Column(modifier = Modifier.weight(1f)) {
                                        Text(
                                            text = book.title,
                                            style = MaterialTheme.typography.titleMedium,
                                            fontFamily = PlayfairFontFamily,
                                            fontWeight = FontWeight.Bold,
                                            color = MaterialTheme.colorScheme.onSurface
                                        )
                                        Text(
                                            text = book.author,
                                            style = MaterialTheme.typography.bodySmall,
                                            color = MutedInkText
                                        )
                                        Spacer(modifier = Modifier.height(6.dp))
                                        LinearProgressIndicator(
                                            progress = { book.currentPage.toFloat() / book.totalPages.coerceAtLeast(1) },
                                            modifier = Modifier.fillMaxWidth().height(4.dp),
                                            color = WarmAmberPrimary,
                                            trackColor = ParchmentSurface
                                        )
                                    }

                                    Spacer(modifier = Modifier.width(12.dp))

                                    IconButton(onClick = { onNavigateToReader(book.id) }) {
                                        Icon(
                                            imageVector = Icons.Default.PlayArrow,
                                            contentDescription = "Читать",
                                            tint = WarmAmberPrimary
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
                1 -> {
                    // Quotes Tab
                    if (quotes.isEmpty()) {
                        EmptyShelfNotice("У вас пока нет сохраненных цитат. Читайте книги и нажимайте «Цитата»!")
                    } else {
                        LazyColumn(
                            modifier = Modifier.fillMaxSize(),
                            contentPadding = PaddingValues(16.dp),
                            verticalArrangement = Arrangement.spacedBy(14.dp)
                        ) {
                            items(quotes) { quote ->
                                QuoteShelfCard(
                                    quote = quote,
                                    onMakeVideo = {
                                        onNavigateToVideoStudio(quote.text, quote.author, quote.bookTitle)
                                    },
                                    onDelete = { viewModel.deleteQuote(quote.id) }
                                )
                            }
                        }
                    }
                }
                2 -> {
                    // Video Stories Tab
                    if (videoStories.isEmpty()) {
                        EmptyShelfNotice("Здесь появятся ваши кинематографические рилсы. Перейдите в раздел «Живое Видео» и создайте первый ролик!")
                    } else {
                        LazyColumn(
                            modifier = Modifier.fillMaxSize(),
                            contentPadding = PaddingValues(16.dp),
                            verticalArrangement = Arrangement.spacedBy(16.dp)
                        ) {
                            items(videoStories) { story ->
                                VideoShelfCard(
                                    story = story,
                                    onPlay = { activePlayingStory = story },
                                    onDelete = { viewModel.deleteVideoStory(story.id) }
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    // Fullscreen / Bottomsheet Player for saved video story
    activePlayingStory?.let { story ->
        ModalBottomSheet(
            onDismissRequest = { activePlayingStory = null },
            sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true),
            containerColor = Color.Black
        ) {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(16.dp)
            ) {
                AtmosphericVideoPlayer(
                    quoteText = story.quoteText,
                    author = story.author,
                    bookTitle = story.bookTitle,
                    visualMood = story.visualMood,
                    narrationText = story.narrationText,
                    onPlayNarration = {
                        viewModel.ttsManager.speak(story.narrationText)
                    },
                    modifier = Modifier.fillMaxSize()
                )

                IconButton(
                    onClick = { activePlayingStory = null },
                    modifier = Modifier
                        .align(Alignment.TopEnd)
                        .padding(8.dp)
                        .background(Color.Black.copy(alpha = 0.5f), CircleShape)
                ) {
                    Icon(
                        imageVector = Icons.Default.Close,
                        contentDescription = "Закрыть",
                        tint = Color.White
                    )
                }
            }
        }
    }
}

@Composable
fun QuoteShelfCard(
    quote: QuoteEntity,
    onMakeVideo: () -> Unit,
    onDelete: () -> Unit
) {
    Card(
        shape = RoundedCornerShape(16.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
    ) {
        Column(modifier = Modifier.padding(18.dp)) {
            Text(
                text = "«${quote.text}»",
                fontFamily = PlayfairFontFamily,
                fontSize = 17.sp,
                lineHeight = 24.sp,
                color = MaterialTheme.colorScheme.onSurface
            )

            Spacer(modifier = Modifier.height(10.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "— ${quote.author}, «${quote.bookTitle}»",
                    style = MaterialTheme.typography.bodySmall,
                    color = MutedInkText,
                    modifier = Modifier.weight(1f)
                )

                IconButton(onClick = onDelete) {
                    Icon(
                        imageVector = Icons.Default.DeleteOutline,
                        contentDescription = "Удалить цитату",
                        tint = MutedInkText
                    )
                }

                Surface(
                    onClick = onMakeVideo,
                    color = WarmAmberPrimary,
                    shape = RoundedCornerShape(10.dp)
                ) {
                    Row(
                        modifier = Modifier.padding(horizontal = 10.dp, vertical = 6.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(
                            imageVector = Icons.Default.AutoAwesome,
                            contentDescription = null,
                            tint = Color.White,
                            modifier = Modifier.size(14.dp)
                        )
                        Spacer(modifier = Modifier.width(4.dp))
                        Text(
                            text = "Видео 9:16",
                            style = MaterialTheme.typography.labelSmall,
                            color = Color.White
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun VideoShelfCard(
    story: VideoStoryEntity,
    onPlay: () -> Unit,
    onDelete: () -> Unit
) {
    Card(
        shape = RoundedCornerShape(16.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
        modifier = Modifier.clickable(onClick = onPlay)
    ) {
        Row(
            modifier = Modifier.padding(14.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Box(
                modifier = Modifier
                    .size(60.dp)
                    .clip(RoundedCornerShape(12.dp))
                    .background(Color(0xFF261E17)),
                contentAlignment = Alignment.Center
            ) {
                Icon(
                    imageVector = Icons.Default.PlayArrow,
                    contentDescription = "Воспроизвести",
                    tint = GoldenGlow,
                    modifier = Modifier.size(32.dp)
                )
            }

            Spacer(modifier = Modifier.width(14.dp))

            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = story.title,
                    style = MaterialTheme.typography.titleSmall,
                    fontFamily = PlayfairFontFamily,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.onSurface
                )
                Text(
                    text = "«${story.quoteText.take(50)}...»",
                    style = MaterialTheme.typography.bodySmall,
                    color = MutedInkText,
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis
                )
                Text(
                    text = "Настроение: ${story.visualMood}",
                    style = MaterialTheme.typography.labelSmall,
                    color = WarmAmberPrimary
                )
            }

            IconButton(onClick = onDelete) {
                Icon(
                    imageVector = Icons.Default.DeleteOutline,
                    contentDescription = "Удалить видео",
                    tint = MutedInkText
                )
            }
        }
    }
}

@Composable
fun EmptyShelfNotice(message: String) {
    Box(
        modifier = Modifier
            .fillMaxSize()
            .padding(32.dp),
        contentAlignment = Alignment.Center
    ) {
        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            Icon(
                imageVector = Icons.Default.MenuBook,
                contentDescription = null,
                tint = WarmAmberPrimary.copy(alpha = 0.5f),
                modifier = Modifier.size(48.dp)
            )
            Spacer(modifier = Modifier.height(12.dp))
            Text(
                text = message,
                style = MaterialTheme.typography.bodyMedium,
                color = MutedInkText,
                textAlign = androidx.compose.ui.text.style.TextAlign.Center
            )
        }
    }
}
